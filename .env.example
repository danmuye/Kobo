# Firebase Configuration (required for Firebase backend)
# Copy this file to .env and fill in your values.
# Get these from your Firebase Console → Project Settings → General → Your apps → Web app

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ImgBB API Key (required for ImgBB image upload provider)
# Get your key at https://api.imgbb.com/
VITE_IMGBB_API_KEY=
